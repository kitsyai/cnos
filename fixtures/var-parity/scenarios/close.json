  {
    "name": "close-during-an-in-flight-start",
    "axis": "close",
    "why": "ADR Open decision 9 (RESOLVED): close() ABORTS the in-flight prefetch and returns PROMPTLY (bounded here while the pull is still gated, only possible with a real abort — the TS provider contract gained an AbortSignal); the startup caller observes a closed-kind error",
    "projection": {
      "values": { "policy.mode": "static-value" },
      "varSources": { "svc": { "transport": "fake" } },
      "vars": { "policy": { "source": "svc", "mode": "prefetch" } },
      "schema": { "var.policy.mode": { "type": "string" } }
    },
    "source": {
      "policy": {
        "kind": "head",
        "generation": 1,
        "revision": "sha256:r1",
        "effectiveAt": "2026-07-20T00:00:00Z",
        "values": { "policy.mode": "v1" }
      }
    },
    "steps": [
      { "action": "blockPull", "scope": "policy" },
      { "action": "startAsync" },
      { "action": "awaitPullIssued", "scope": "policy", "count": 1, "timeoutMs": 3000 },
      { "action": "closeAsync" },
      {
        "action": "expect",
        "closeSettledWithinMs": 400,
        "settled": true,
        "note": "close() settles within 400ms WHILE the pull is still gated (releasePull has not run yet) — only a real abort of the in-flight prefetch makes this possible, in both SDKs."
      },
      { "action": "releasePull", "scope": "policy" },
      { "action": "awaitClose" },
      { "action": "awaitStart" },
      { "action": "expect", "startOutcome": "error", "startErrorKind": "closed" },
      { "action": "expect", "closeOutcome": "ok" }
    ]
  },
