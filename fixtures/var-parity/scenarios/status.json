[
  {
    "name": "status-shape-for-an-applied-runtime-head",
    "axis": "status",
    "why": "delta 7: varStatus() is keyed by the prefix-stripped full var key and reports the tier actually serving it",
    "projection": {
      "values": {},
      "varSources": { "svc": { "transport": "fake" } },
      "vars": { "policy": { "source": "svc", "mode": "prefetch", "lease": "10m" } },
      "schema": { "var.policy.mode": { "type": "string" } }
    },
    "source": {
      "policy": {
        "kind": "head",
        "generation": 12,
        "revision": "sha256:r1",
        "effectiveAt": "2026-07-20T00:00:00Z",
        "values": { "policy.mode": "v1" }
      }
    },
    "steps": [
      { "action": "start" },
      {
        "action": "expect",
        "status": {
          "key": "var.policy.mode",
          "source": "runtime",
          "freshness": "fresh",
          "appliedGeneration": 12,
          "revision": true,
          "desiredGeneration": true,
          "lastError": false,
          "lastRejected": false
        }
      }
    ]
  },
  {
    "name": "status-for-a-never-fetched-key-names-the-fallback-tier",
    "axis": "status",
    "why": "delta 16: with no runtime head status names static/default, never a phantom `runtime`",
    "projection": {
      "values": { "policy.mode": "static-value" },
      "varSources": { "svc": { "transport": "fake" } },
      "vars": { "policy": { "source": "svc", "mode": "ondemand" } },
      "schema": {
        "var.policy.mode": { "type": "string" },
        "var.policy.other": { "type": "string", "default": "d" }
      }
    },
    "source": { "policy": { "kind": "no-head" } },
    "steps": [
      { "action": "start" },
      {
        "action": "expect",
        "status": {
          "key": "var.policy.mode",
          "source": "static",
          "freshness": "fresh",
          "appliedGeneration": 0,
          "revision": false,
          "desiredGeneration": false
        }
      },
      { "action": "expect", "status": { "key": "var.policy.other", "source": "default", "appliedGeneration": 0, "revision": false } }
    ]
  },
  {
    "name": "status-for-a-key-that-resolves-from-no-tier-at-all",
    "axis": "status",
    "why": "ADR Open decision 8 (RESOLVED): a key resolving from NO tier reports source `none` AND freshness `none` in both SDKs (Go's Freshness enum gained the `none` member)",
    "projection": {
      "values": {},
      "varSources": { "svc": { "transport": "fake" } },
      "vars": { "policy": { "source": "svc", "mode": "ondemand" } },
      "schema": { "var.policy.mode": { "type": "string" } }
    },
    "source": { "policy": { "kind": "no-head" } },
    "steps": [
      { "action": "start" },
      {
        "action": "expect",
        "status": { "key": "var.policy.mode", "source": "none", "freshness": "none", "appliedGeneration": 0, "revision": false },
        "note": "ADR, deactivation section + freshness table `none` row: varStatus() reports `source: 'static' | 'default'`, or `'none'`/`'none'` when the key resolves nowhere. Go used to report source `default` then `none`/`fresh`; now `none`/`none` in both SDKs."
      }
    ]
  },
  {
    "name": "status-after-a-deactivation-never-masquerades-as-applied",
    "axis": "status",
    "why": "round-2 blocker 1: a removed head clears revision/desiredGeneration and appliedGeneration returns to 0",
    "projection": {
      "values": { "policy.mode": "static-value" },
      "varSources": { "svc": { "transport": "fake" } },
      "vars": { "policy": { "source": "svc", "mode": "prefetch" } },
      "schema": { "var.policy.mode": { "type": "string" } }
    },
    "source": {
      "policy": {
        "kind": "head",
        "generation": 12,
        "revision": "sha256:r1",
        "effectiveAt": "2026-07-20T00:00:00Z",
        "values": { "policy.mode": "v1" }
      }
    },
    "steps": [
      { "action": "start" },
      { "action": "expect", "status": { "key": "var.policy.mode", "source": "runtime", "appliedGeneration": 12, "revision": true } },
      { "action": "push", "scope": "policy", "event": { "kind": "no-head" } },
      {
        "action": "expect",
        "status": {
          "key": "var.policy.mode",
          "source": "static",
          "freshness": "fresh",
          "appliedGeneration": 0,
          "revision": false,
          "desiredGeneration": false,
          "lastError": false
        }
      }
    ]
  }
]
