      { "action": "watch", "id": "w1", "key": "var.policy.mode" },
      { "action": "expect", "status": { "key": "var.policy.mode", "lastError": true } },
      { "action": "setSource", "scope": "policy", "response": { "kind": "no-head" } },
      { "action": "refreshVars" },
      { "action": "expect", "watch": { "id": "w1", "fires": [] } },
      {
        "action": "expect",
