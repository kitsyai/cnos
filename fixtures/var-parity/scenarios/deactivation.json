      { "action": "read", "key": "var.policy.mode" },
      { "action": "expect", "read": { "found": true, "value": "live", "source": "runtime" } },
      { "action": "push", "scope": "policy", "event": { "kind": "no-head" } },
      { "action": "read", "key": "var.policy.mode" },
      { "action": "expect", "read": { "found": true, "value": "static-value", "source": "static" } },
