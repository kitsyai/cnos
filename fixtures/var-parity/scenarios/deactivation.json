          "effectiveAt": "2026-07-20T00:00:00Z",
          "values": { "policy.mode": "live-again" }
        }
      },
      { "action": "read", "key": "var.policy.mode" },
      { "action": "expect", "read": { "found": true, "value": "live-again", "source": "runtime" } }
    ]
  },
