      {
        "action": "push",
        "scope": "policy",
        "event": {
          "kind": "batch",
          "generation": 1,
          "revision": "sha256:r1",
          "effectiveAt": "2026-07-20T00:00:00Z",
          "values": { "policy.mode": "live" }
