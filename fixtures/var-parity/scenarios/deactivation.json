[
  {
    "name": "deactivate-via-pull-clears-runtime-tier",
    "axis": "deactivation",
    "why": "round-2 blocker 1 / acceptance #15: a pulled no-head is an atomic scope removal, watchers fire with the tier that took over",
    "projection": {
      "values": { "policy.mode": "static-value" },
      "varSources": { "svc": { "transport": "fake" } },
      "vars": { "policy": { "source": "svc", "mode": "prefetch" } },
      "schema": { "var.policy.mode": { "type": "string" } }
    },
    "source": {
      "policy": {
        "kind": "head",
        "generation": 4,
        "revision": "sha256:r1",
        "effectiveAt": "2026-07-20T00:00:00Z",
        "values": { "policy.mode": "live" }
      }
    },
    "steps": [
      { "action": "start" },
      { "action": "expect", "startOutcome": "ok" },
      { "action": "read", "key": "var.policy.mode" },
      { "action": "expect", "read": { "found": true, "value": "live", "source": "runtime" } },
      { "action": "watch", "id": "w1", "key": "var.policy.mode" },
      { "action": "setSource", "scope": "policy", "response": { "kind": "no-head" } },
      { "action": "refreshVars" },
      { "action": "read", "key": "var.policy.mode" },
      { "action": "expect", "read": { "found": true, "value": "static-value", "source": "static", "freshness": "fresh" } },
      { "action": "expect", "watch": { "id": "w1", "fires": [{ "source": "static", "value": "static-value" }] } },
      {
        "action": "expect",
        "status": {
          "key": "var.policy.mode",
          "source": "static",
          "freshness": "fresh",
          "appliedGeneration": 0,
          "revision": false,
          "desiredGeneration": false,
          "lastError": false
        }
      }
    ]
  },
