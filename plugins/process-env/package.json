{
  "name": "@kitsy/cnos-plugin-process-env",
  "private": true,
  "version": "0.0.1",
  "description": "process.env integration plugin scaffold for CNOS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitsyai/cnos.git",
    "directory": "plugins/process-env"
  },
  "homepage": "https://github.com/kitsyai/cnos/tree/main/plugins/process-env",
  "bugs": {
    "url": "https://github.com/kitsyai/cnos/issues"
  },
  "keywords": [
    "cnos",
    "plugin",
    "process-env"
  ],
  "dependencies": {
    "@kitsy/cnos-core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts --watch --format esm,cjs --dts",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
