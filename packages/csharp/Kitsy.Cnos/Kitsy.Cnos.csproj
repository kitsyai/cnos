<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Kitsy.Cnos</RootNamespace>
    <AssemblyName>Kitsy.Cnos</AssemblyName>

    <PackageId>Kitsy.Cnos</PackageId>
    <Version>1.12.3</Version>
    <Authors>Prashant Sinha</Authors>
    <Company>Kitsy AI</Company>
    <Description>CNOS C# client runtime â€” consumes a server projection and provides typed read APIs for value, secret, meta, and public namespaces.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kitsyai/cnos</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kitsyai/cnos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cnos;configuration;secrets;kitsy</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
