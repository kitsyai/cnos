<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>Kitsy.Cnos.Azure</RootNamespace>
    <AssemblyName>Kitsy.Cnos.Azure</AssemblyName>

    <PackageId>Kitsy.Cnos.Azure</PackageId>
    <Version>1.15.0</Version>
    <Authors>Prashant Sinha</Authors>
    <Company>Kitsy AI</Company>
    <Description>CNOS C# vault provider for Azure Key Vault.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kitsyai/cnos</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kitsyai/cnos</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cnos;configuration;secrets;azure;kitsy</PackageTags>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kitsy.Cnos\Kitsy.Cnos.csproj" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.6.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
  </ItemGroup>
</Project>
