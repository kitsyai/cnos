{
  "name": "@kitsy/cnos-var-http",
  "version": "1.18.0",
  "description": "HTTP transport module for CNOS runtime variables (var.*): pull-based VarSourceProvider with ETag/If-None-Match and secret-ref bearer auth.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@kitsy/cnos-core": "workspace:*",
    "@kitsy/cnos-var-server": "workspace:*",
    "@kitsy/cnos-var-testkit": "workspace:*"
  },
  "scripts": {
    "build": "rimraf dist && tsup --config tsup.config.ts",
    "clean": "rimraf dist",
    "dev": "tsup --config tsup.config.ts --watch",
    "lint": "eslint src test",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
