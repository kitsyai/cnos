{
  "name": "@kitsy/cnos-vault-fake",
  "private": true,
  "version": "1.12.1",
  "description": "Fake remote CNOS vault provider used as a reference implementation for provider conformance.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "dependencies": {
    "@kitsy/cnos-core": "workspace:*"
  },
  "devDependencies": {
    "@kitsy/cnos-vault-testkit": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "clean": "rimraf dist",
    "dev": "tsup src/index.ts --watch --format esm,cjs --dts",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
