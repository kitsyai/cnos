{
    "name": "kitsy/cnos-gcp",
    "description": "CNOS PHP vault provider for GCP Secret Manager.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kitsyai/cnos",
    "authors": [{"name": "Prashant Sinha"}],
    "require": {
        "php": ">=8.0",
        "kitsy/cnos": "^1.12.0",
        "google/cloud-secret-manager": "^1.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Kitsy\\Cnos\\Gcp\\": "src/"
        }
