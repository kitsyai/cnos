    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/kitsyai/cnos",
    "authors": [{"name": "Prashant Sinha"}],
    "require": {
        "php": ">=8.0",
        "kitsy/cnos": "^1.12.0",
        "aws/aws-sdk-php": "^3.0"
